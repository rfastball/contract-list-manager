        {"id":"c16","name":"납품기한","formula":{"version":2,"source":"sql","sql":"SELECT 공문서날짜(CASE WHEN count(*) = 0 THEN '' WHEN sum(v GLOB '[0-9][0-9][0-9][0-9]/[0-9][0-9]/[0-9][0-9]') = count(*) OR count(DISTINCT v) = 1 THEN max(v) ELSE '' END) FROM (SELECT i.납품기한 AS v FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.납품기한) <> '' UNION ALL SELECT 계약.납품기한 WHERE trim(계약.납품기한) <> '' AND NOT EXISTS (SELECT 1 FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.납품기한) <> '') UNION ALL SELECT i.납품기한 FROM v_공고품목 i WHERE i.입찰공고번호 = 공고.입찰공고번호 AND trim(i.납품기한) <> '' AND trim(coalesce(계약.납품기한, '')) = '' AND NOT EXISTS (SELECT 1 FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.납품기한) <> ''))"}},
