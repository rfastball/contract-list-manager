        {"id":"c04","name":"공고명","formula":{"version":2,"source":"flow","flow":{"from":{"kind":"linked","link":"notice","field":"공고명"},"steps":[]}}},
        {"id":"c06","name":"세부품명","formula":{"version":2,"source":"sql","sql":"SELECT r FROM (SELECT CASE WHEN count(*) = 0 THEN '' WHEN count(DISTINCT n) = 1 THEN n ELSE n || ' 외 ' || (count(DISTINCT n) - 1) || '건' END AS r, min(o) FROM (SELECT i.품명 AS n, CAST(i.순번 AS INTEGER) AS o FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.품명) <> '' UNION ALL SELECT 계약.품명, 0 WHERE trim(계약.품명) <> '' AND NOT EXISTS (SELECT 1 FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.품명) <> '') UNION ALL SELECT i.세부품명, CAST(i.순번 AS INTEGER) FROM v_공고품목 i WHERE i.입찰공고번호 = 공고.입찰공고번호 AND trim(i.세부품명) <> '' AND trim(coalesce(계약.품명, '')) = '' AND NOT EXISTS (SELECT 1 FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.품명) <> '')))"}},
        {"id":"c07","name":"세부품명번호","formula":{"version":2,"source":"flow","flow":{"from":{"kind":"linked","link":"notice","field":"세부품명번호"},"steps":[]}}},
        {"id":"c42","name":"세부품명_목록","formula":{"version":2,"source":"sql","sql":"SELECT CASE WHEN total(trim(g.n) = '') > 0 THEN '' ELSE coalesce(group_concat(g.n, ', ' ORDER BY g.o), '') END FROM (SELECT i.세부품명 AS n, min(CAST(i.순번 AS INTEGER)) AS o FROM v_공고품목 i WHERE i.입찰공고번호 = 공고.입찰공고번호 GROUP BY i.세부품명) g"}},
        {"id":"c43","name":"세부품명_번호목록","formula":{"version":2,"source":"sql","sql":"SELECT CASE WHEN total(trim(g.n) = '' OR trim(g.d) = '') > 0 THEN '' ELSE coalesce(group_concat(g.n || '(' || g.d || ')', ', ' ORDER BY g.o), '') END FROM (SELECT i.세부품명 AS n, i.세부품명번호 AS d, min(CAST(i.순번 AS INTEGER)) AS o FROM v_공고품목 i WHERE i.입찰공고번호 = 공고.입찰공고번호 GROUP BY i.세부품명, i.세부품명번호) g"}},
        {"id":"c44","name":"세부품명_수량목록","formula":{"version":2,"source":"sql","sql":"SELECT CASE WHEN total(g.bad) > 0 THEN '' ELSE coalesce(group_concat(g.n || ' / ' || g.q || ' ' || g.u, ', ' ORDER BY g.o), '') END FROM (SELECT i.세부품명 AS n, min(i.단위) AS u, CAST(sum(CAST(i.수량 AS NUMERIC)) AS TEXT) AS q, min(CAST(i.순번 AS INTEGER)) AS o, trim(i.세부품명) = '' OR count(DISTINCT i.단위) <> 1 OR total(trim(i.단위) = '' OR trim(i.수량) = '') > 0 AS bad FROM v_공고품목 i WHERE i.입찰공고번호 = 공고.입찰공고번호 GROUP BY i.세부품명, i.세부품명번호) g"}},
        {"id":"c08","name":"수량","formula":{"version":2,"source":"flow","flow":{"from":{"kind":"linked","link":"contract","field":"수량"},"steps":[{"op":"ifEmpty","field":"공고.수량"}]}}},
        {"id":"c09","name":"단위","formula":{"version":2,"source":"flow","flow":{"from":{"kind":"linked","link":"contract","field":"단위"},"steps":[{"op":"ifEmpty","field":"공고.단위"}]}}},
        {"id":"c10","name":"계약방법","formula":{"version":2,"source":"flow","flow":{"from":{"kind":"linked","link":"notice","field":"계약방법"},"steps":[]}}},
        {"id":"c11","name":"입찰방법","formula":{"version":2,"source":"sql","sql":"SELECT CASE WHEN trim(coalesce(공고.계약방법, '')) = '' THEN '' WHEN trim(coalesce(공고.계약구분, '')) = '' THEN substr(trim(공고.계약방법), 1, 2) ELSE substr(trim(공고.계약방법), 1, 2) || '(' || replace(trim(공고.계약구분), '계약', '') || ')' END"}},
