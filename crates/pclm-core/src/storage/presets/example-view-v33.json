        {"id":"c06","name":"세부품명","formula":{"version":2,"source":"sql","sql":"SELECT r FROM (SELECT CASE WHEN count(*) = 0 THEN '' WHEN count(DISTINCT n) = 1 THEN n ELSE n || ' 외 ' || (count(DISTINCT n) - 1) || '건' END AS r, min(o) FROM (SELECT i.품명 AS n, CAST(i.순번 AS INTEGER) AS o FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.품명) <> '' UNION ALL SELECT 계약.품명, 0 WHERE trim(계약.품명) <> '' AND NOT EXISTS (SELECT 1 FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.품명) <> '') UNION ALL SELECT i.세부품명, CAST(i.순번 AS INTEGER) FROM v_공고품목 i WHERE i.입찰공고번호 = 공고.입찰공고번호 AND trim(i.세부품명) <> '' AND trim(coalesce(계약.품명, '')) = '' AND NOT EXISTS (SELECT 1 FROM v_계약품목 i WHERE i.계약번호 = 계약.계약번호 AND trim(i.품명) <> '')))"}},
