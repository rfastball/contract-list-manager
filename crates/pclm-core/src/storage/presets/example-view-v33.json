        {"id":"c11","name":"입찰방법","formula":{"version":2,"source":"sql","sql":"SELECT CASE WHEN trim(coalesce(공고.계약방법, '')) = '' THEN '' WHEN trim(coalesce(공고.계약구분, '')) = '' THEN substr(trim(공고.계약방법), 1, 2) ELSE substr(trim(공고.계약방법), 1, 2) || '(' || replace(trim(공고.계약구분), '계약', '') || ')' END"}},
