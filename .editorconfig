# 저장소의 파일 모양을 한 곳에서 정한다. 편집기가 바뀌어도 diff 에 공백만 남는 일이 없게.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,mts,json,jsonc,css,html,yml,yaml}]
indent_size = 2

[*.md]
# 줄 끝 두 칸이 줄바꿈이라 지우면 안 된다.
trim_trailing_whitespace = false

[*.{cs,ps1}]
# 한글이 든 파일이라 BOM 을 남긴다 — Windows PowerShell 5.1 은 BOM 이 없으면
# UTF-8 을 시스템 코드페이지로 읽어 글자가 깨진다.
charset = utf-8-bom

[*.csproj]
indent_size = 2

[*.sln]
indent_style = tab
