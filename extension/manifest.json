{
  "manifest_version": 3,
  "key": "",
  "name": "계약 목록 — 나라장터 연결",
  "version": "0.10.1",
  "description": "나라장터 화면을 계약 목록 앱에 이어 줍니다. 가져오기는 계약 목록의 「지금 보는 화면」에서 하고, 현재 화면은 엑셀로 내보낼 수 있습니다.",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.g2b.go.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "계약 목록"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
