{
  "manifest_version": 3,
  "key": "",
  "name": "계약 목록 — 나라장터 연결",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "나라장터 화면을 계약 목록 앱에 이어 줍니다. 앱에서 직접 가져오거나 설정한 조건으로 자동 저장하고, 현재 화면은 엑셀로 내보내며, 계약 목록에 저장된 값으로 서식을 채워 문서를 만듭니다.",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "https://www.g2b.go.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "계약 목록"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
