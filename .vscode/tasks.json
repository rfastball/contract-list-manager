{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "빌드",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "pclm-desktop", "--features", "shell"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "명령줄 빌드",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "pclm-cli"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "화면 짓기",
      "type": "shell",
      "command": "npx",
      "args": ["vite", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "//": "창을 지어 둔 화면으로 띄우기 전에 도는 것. 화면부터 짓고 그다음 빌드다 — 순서를 건너뛰면 옛 화면이 exe 에 박힌다.",
      "label": "빌드 (화면 포함)",
      "dependsOrder": "sequence",
      "dependsOn": ["화면 짓기", "빌드"],
      "problemMatcher": []
    },
    {
      "//": "개발 서버. isBackground 라 계속 도는데, VS Code 가 '언제 준비됐나'를 알아야 창을 띄우므로 vite 가 찍는 줄로 그것을 잡는다.",
      "label": "개발 서버",
      "type": "shell",
      "command": "npx",
      "args": ["vite", "--port", "5173", "--strictPort"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "개발 서버 + 창 빌드",
      "dependsOrder": "sequence",
      "dependsOn": ["빌드", "개발 서버"],
      "problemMatcher": []
    },
    {
      "label": "시험 (전부)",
      "dependsOn": ["시험 (Rust)", "시험 (화면)"],
      "problemMatcher": []
    },
    {
      "label": "시험 (Rust)",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "시험 (화면)",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
