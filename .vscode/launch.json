{
  "version": "0.2.0",
  "configurations": [
    {
      "//": "배포본과 같은 모양. 지어 둔 화면(artifacts/web)을 exe 에 박아 연다. 디버거는 C/C++ 확장의 cppvsdbg.",
      "name": "창",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "빌드 (화면 포함)",
      "program": "${workspaceFolder}/target/debug/pclm-desktop.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "//": "화면은 개발 서버에서, 다리와 DB 는 진짜(홈은 artifacts/dev-home). 화면을 고치면 창 안에서 곧바로 바뀐다.",
      "name": "창 · 개발 서버",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "개발 서버 + 창 빌드",
      "program": "${workspaceFolder}/target/debug/pclm-desktop.exe",
      "args": ["--ui", "http://localhost:5173/", "--home", "${workspaceFolder}/artifacts/dev-home"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "//": "실제 자료를 건드리지 않고 띄운다(홈 artifacts/dev-home). 판올림이나 넣기를 시험할 때.",
      "name": "창 · 시험용 자료",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "빌드 (화면 포함)",
      "program": "${workspaceFolder}/target/debug/pclm-desktop.exe",
      "args": ["--home", "${workspaceFolder}/artifacts/dev-home"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "명령줄",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "명령줄 빌드",
      "program": "${workspaceFolder}/target/debug/pclm.exe",
      "args": ["${input:명령}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "명령",
      "type": "pickString",
      "description": "무엇을 돌릴까요",
      "options": ["status", "link", "set", "export", "help"],
      "default": "status"
    }
  ]
}
